# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=your-deepseek-key
ANTHROPIC_MODEL=deepseek-v4-pro

# Arc testnet RPC — get via `arc-canteen rpc-url`
ARC_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com/v1/your-token
ARC_CHAIN_ID=5042002

# Polygon mainnet (Polymarket runs here)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137

# Filled after Builder Profile registration
POLYMARKET_BUILDER_CODE=

# Agent EOA used to sign picks + deploy contracts (NEVER mainnet funds)
AGENT_PRIVATE_KEY=
